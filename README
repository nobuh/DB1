# Edward Sciore "Database Design and Implementation" の実装を学ぶ

## ビルド 

- File

javac -cp bin -d bin src/simpledb/file/BlockId.java
javac -cp bin -d bin src/simpledb/file/Page.java
javac -cp bin -d bin src/simpledb/file/FileMgr.java
javac -cp bin -d bin src/simpledb/server/SimpleDB.java
javac -cp bin -d bin src/simpledb/file/FileTest.java
java -cp bin simpledb.file.FileTest

- Log

javac -cp bin -d bin src/simpledb/log/LogIterator.java
javac -cp bin -d bin src/simpledb/log/LogMgr.java
javac -cp bin -d bin src/simpledb/server/SimpleDB.java
javac -cp bin -d bin src/simpledb/log/LogTest.java
java -cp bin simpledb.log.LogTest

- Buffer

javac -cp bin -d bin src/simpledb/buffer/Buffer.java
javac -cp bin -d bin src/simpledb/buffer/BufferAbortException.java
javac -cp bin -d bin src/simpledb/buffer/BufferMgr.java
javac -cp bin -d bin src/simpledb/server/SimpleDB.java
javac -cp bin -d bin src/simpledb/buffer/BufferTest.java
java -cp bin simpledb.buffer.BufferTest

javac -cp bin -d bin src/simpledb/buffer/BufferMgrTest.java
java -cp bin simpledb.buffer.BufferMgrTest
